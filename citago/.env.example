# Copy to .env and adjust. Never commit .env.
# Every variable listed here is validated at boot: the API refuses to start
# with an invalid configuration.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MySQL 8+) ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=citago_dev
DB_DATABASE=citago
# Logs every SQL statement. Development only.
DB_LOGGING=false

# ── API ──────────────────────────────────────────────────────────────────────
# Must be false in production.
SWAGGER_ENABLED=true
# Comma-separated browser origins. Empty disables CORS, which is correct while
# the only client is the Flutter app.
CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_LIMIT=120
THROTTLE_TTL=60000

# ── Authentication ───────────────────────────────────────────────────────────
# At least 32 characters. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value-32-chars-min
# Access token lifetime in seconds (60-3600). Short on purpose.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Requests per window on /auth, per IP. Stricter than the global limit.
AUTH_THROTTLE_LIMIT=20

# ── Development tools ────────────────────────────────────────────────────────
# Enables POST /api/v1/conversations/simulate-inbound. Must be false in production.
DEV_TOOLS_ENABLED=false

# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32 random bytes in base64. Encrypts WhatsApp access tokens (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-with-32-random-bytes-in-base64-44ch=

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# App secret from the Meta app dashboard. Verifies webhook signatures.
# Empty disables the webhook (it rejects every request).
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v23.0
