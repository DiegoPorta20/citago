# Copy to .env and adjust. Never commit .env.
# Every variable listed here is validated at boot: the API refuses to start
# with an invalid configuration.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MySQL 8+) ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=citago_test
# Logs every SQL statement. Development only.
DB_LOGGING=false

# ── API ──────────────────────────────────────────────────────────────────────
# Must be false in production.
SWAGGER_ENABLED=true
# Comma-separated browser origins. Empty disables CORS, which is correct while
# the only client is the Flutter app.
CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_LIMIT=120
THROTTLE_TTL=60000

# ── Authentication ───────────────────────────────────────────────────────────
# At least 32 characters. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value-32-chars-min
# Access token lifetime in seconds (60-3600). Short on purpose.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Requests per window on /auth, per IP. Stricter than the global limit.
AUTH_THROTTLE_LIMIT=20

# ── Development tools ────────────────────────────────────────────────────────
# Enables POST /api/v1/conversations/simulate-inbound. Must be false in production.
DEV_TOOLS_ENABLED=false

# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32 random bytes in base64. Encrypts WhatsApp access tokens (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-with-32-random-bytes-in-base64-44ch=

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# App secret from the Meta app dashboard. Verifies webhook signatures.
# Empty disables the webhook (it rejects every request).
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v23.0

# Public https origin of this API. The WhatsApp sign-up and Culqi checkout pages
# are served from it, so Meta and Culqi must be able to reach it.
PUBLIC_BASE_URL=http://localhost:3000
# Embedded Signup (automatic WhatsApp connection). Needs a Meta app that is a
# Tech Provider; WHATSAPP_APP_SECRET above is the same app's secret. The config
# id comes from Facebook Login for Business > Configurations. Empty disables it.
WHATSAPP_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Email (Amazon SES) ───────────────────────────────────────────────────────
# log prints the message instead of sending it (development). ses sends it.
EMAIL_PROVIDER=log
# A verified SES identity, e.g. CitaGo <avisos@citago.pe>. Required for ses.
EMAIL_FROM=
SES_REGION=us-east-1
# No AWS keys here: credentials come from the default AWS chain (task/instance
# role in production; ws configure or AWS_* variables locally).
# Runs the trial/payment reminder job inside this process.
REMINDERS_ENABLED=false

# ── Payments (Culqi) ─────────────────────────────────────────────────────────
# Keys from CulqiPanel (use the integration/test ones outside production).
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_API_URL=https://api.culqi.com/v2
# Random string. Webhook URL to register in CulqiPanel (Eventos > Webhooks):
#   https://<PUBLIC_BASE_URL>/api/v1/webhooks/culqi?secret=<this value>
CULQI_WEBHOOK_SECRET=
# Plans are created once in CulqiPanel (monthly, in PEN, at the prices in
# billing/domain/plan.ts). Paste their ids here.
CULQI_PLAN_STARTER_ID=
CULQI_PLAN_PRO_ID=
CULQI_PLAN_BUSINESS_ID=
