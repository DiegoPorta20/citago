{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "setupFiles": [
    "reflect-metadata",
    "<rootDir>/test/support/load-env.ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "clearMocks": true,
  "testTimeout": 20000
}
